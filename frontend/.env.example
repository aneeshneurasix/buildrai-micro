# Frontend Environment Variables

# Build Mode (static for S3, standalone for Docker)
BUILD_MODE=static

# API URLs
NEXT_PUBLIC_API_URL=https://api.codstack.com
NEXT_PUBLIC_AI_SERVICE_URL=https://api.codstack.com

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Deployment (for npm run deploy)
S3_BUCKET=codstack-frontend-prod
CLOUDFRONT_ID=your_cloudfront_distribution_id
AWS_REGION=ap-south-1
